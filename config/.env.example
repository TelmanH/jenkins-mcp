# Copy to config/.env. Never commit config/.env.
# One USER/TOKEN pair per instance in jenkins_instances.yaml: JENKINS_<NAME>_USER / JENKINS_<NAME>_TOKEN
# (instance name upper-cased, non-alphanumeric characters replaced by '_').
# The token is a Jenkins API token (Jenkins -> your user -> Security -> API Token), not your password.
JENKINS_MAIN_USER=your-user-id
JENKINS_MAIN_TOKEN=paste-api-token-here

# JENKINS_STAGING_USER=your-user-id
# JENKINS_STAGING_TOKEN=...

# Optional tuning
# JENKINS_MCP_MAX_CHARS=12000       # hard size limit of one tool output
# JENKINS_MCP_CACHE_DIR=            # default: ~/.cache/jenkins-mcp
# JENKINS_MCP_CACHE_MAX_MB=1024
# JENKINS_MCP_MAX_LOG_MB=200        # bigger logs keep head + tail only
# JENKINS_MCP_KB_DIR=               # knowledge base folder, default: <project>/knowledge
